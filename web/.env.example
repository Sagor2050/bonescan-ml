# Copy to web/.env.live and fill in. Never commit the real values.
# Run with: npm run dev -- --mode live
# Not web/.env: Vite loads that for tests too, which would use the real project.
# The anon key is meant for browsers. Row-level security is what protects data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_READER_URL=http://localhost:8000

# Server only. The shared-link routes in web/api/ read these from the Vercel
# project's environment variables (Production and Preview), not from this file.
# The service-role key passes row-level security, so it never gets a VITE_
# prefix, never goes in a local env file, and never reaches a browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

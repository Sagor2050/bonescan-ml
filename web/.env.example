# Copy to web/.env.live and fill in. Never commit the real values.
# Run with: npm run dev -- --mode live
# Not web/.env: Vite loads that for tests too, which would use the real project.
# The anon key is meant for browsers. Row-level security is what protects data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_READER_URL=http://localhost:8000
